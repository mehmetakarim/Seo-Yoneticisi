{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SEO Yöneticisi",
  "version": "0.17.0",
  "identifier": "com.kurumsalit.seo-yoneticisi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SEO Yöneticisi",
        "width": 1360,
        "height": 860,
        "minWidth": 1200,
        "minHeight": 720,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mehmetakarim/Seo-Yoneticisi/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1Mjk3OThCQ0E1OUJENkMKUldSc3ZWbktpM2twRlhFSy9POHlWTlZFL2NJVEtRSVlDcmdoZ3ljT3o5QVRZSThDZENFYVkvUEMK"
    }
  }
}
